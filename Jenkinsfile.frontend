// Pipeline CI - Frontend (Ejercicio5Cliente)
// Práctica 3: Actualización de microservicios y pipelines CI · UTNG
pipeline {
    agent any

    tools {
        jdk   'jdk21'
        maven 'maven-3.9'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Versiones (Java 21 y Maven)') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Compilar') {
            steps {
                dir('Ejercicio5Cliente') {
                    sh 'mvn -o -B test-compile'
                }
            }
        }

        stage('Pruebas Unitarias (JUnit)') {
            steps {
                dir('Ejercicio5Cliente') {
                    sh 'mvn -o -B test'
                }
            }
            post {
                always {
                    junit 'Ejercicio5Cliente/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Cobertura JaCoCo') {
            steps {
                dir('Ejercicio5Cliente') {
                    sh 'mvn -o -B jacoco:report jacoco:check'
                }
                jacoco(
                    execPattern: 'Ejercicio5Cliente/target/jacoco.exec',
                    classPattern: 'Ejercicio5Cliente/target/classes',
                    sourcePattern: 'Ejercicio5Cliente/src/main/java',
                    exclusionPattern: '**/Ejercicio5ClienteApplication.class,**/modelo/**'
                )
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'Ejercicio5Cliente/target/site/jacoco',
                    reportFiles: 'index.html',
                    reportName: 'Reporte Cobertura JaCoCo - Frontend'
                ])
            }
        }

        stage('Análisis SonarQube') {
            steps {
                dir('Ejercicio5Cliente') {
                    withSonarQubeEnv('sonarqube') {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            sh 'mvn -o -B sonar:sonar -Dsonar.login="${SONAR_TOKEN}"'
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Escaneo de Seguridad (Trivy)') {
            steps {
                dir('Ejercicio5Cliente') {
                    sh '''
                        trivy fs . --skip-db-update --skip-check-update --offline-scan \
                            --scanners vuln,secret,misconfig \
                            --skip-dirs target,bin,src/main/resources/static/Images \
                            --format table -o target/trivy-frontend.txt
                        trivy fs . --skip-db-update --skip-check-update --offline-scan \
                            --scanners vuln,secret,misconfig \
                            --skip-dirs target,bin,src/main/resources/static/Images \
                            --format json -o target/trivy-frontend.json
                        cat target/trivy-frontend.txt
                    '''
                }
            }
        }

        stage('Empaquetar y Archivar JAR') {
            steps {
                dir('Ejercicio5Cliente') {
                    sh 'mvn -o -B package -DskipTests'
                }
                archiveArtifacts artifacts: 'Ejercicio5Cliente/target/*.jar,Ejercicio5Cliente/target/trivy-frontend.*,Ejercicio5Cliente/target/site/jacoco/**', fingerprint: true
            }
        }
    }
}
