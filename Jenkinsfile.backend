// Pipeline CI - Backend (Ejercicio5MyAPIGestor)
// Práctica 3: Actualización de microservicios y pipelines CI · UTNG
pipeline {
    agent any

    tools {
        jdk   'jdk21'
        maven 'maven-3.9'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Versiones (Java 21 y Maven)') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Compilar') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh 'mvn -o -B test-compile'
                }
            }
        }

        stage('Pruebas Unitarias (JUnit)') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh 'mvn -o -B test'
                }
            }
            post {
                always {
                    junit 'Ejercicio5MyAPIGestor/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Cobertura JaCoCo') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh 'mvn -o -B jacoco:report jacoco:check'
                }
                jacoco(
                    execPattern: 'Ejercicio5MyAPIGestor/target/jacoco.exec',
                    classPattern: 'Ejercicio5MyAPIGestor/target/classes',
                    sourcePattern: 'Ejercicio5MyAPIGestor/src/main/java',
                    exclusionPattern: '**/Ejercicio5MyApiGestorApplication.class,**/modelo/**'
                )
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'Ejercicio5MyAPIGestor/target/site/jacoco',
                    reportFiles: 'index.html',
                    reportName: 'Reporte Cobertura JaCoCo - Backend'
                ])
            }
        }

        stage('Análisis SonarQube') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    withSonarQubeEnv('sonarqube') {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            sh 'mvn -o -B sonar:sonar -Dsonar.login="${SONAR_TOKEN}"'
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Escaneo de Seguridad (Trivy)') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh '''
                        trivy fs . --skip-db-update --skip-check-update --offline-scan \
                            --scanners vuln,secret,misconfig \
                            --skip-dirs target \
                            --format table -o target/trivy-backend.txt
                        cat target/trivy-backend.txt
                    '''
                }
            }
        }

        stage('Empaquetar y Archivar JAR') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh 'mvn -o -B package -DskipTests'
                }
                archiveArtifacts artifacts: 'Ejercicio5MyAPIGestor/target/*.jar,Ejercicio5MyAPIGestor/target/trivy-backend.*,Ejercicio5MyAPIGestor/target/site/jacoco/**', fingerprint: true
            }
        }
    }
}
