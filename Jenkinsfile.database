// Pipeline CI - Base de Datos (dbgestor en MariaDB 11)
// Práctica 3: Actualización de microservicios y pipelines CI · UTNG
pipeline {
    agent any

    tools {
        jdk   'jdk21'
        maven 'maven-3.9'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        DB_HOST = 'mariadb-ci'
        DB_NAME = 'dbgestor'
        DB_USER = 'root'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Versiones y Herramientas') {
            steps {
                sh '''
                    java -version
                    mvn -version
                    mariadb --version
                    sqlfluff --version
                '''
            }
        }

        stage('Importar Dump en MariaDB 11') {
            steps {
                withCredentials([string(credentialsId: 'mariadb-ci-password', variable: 'DB_PASS')]) {
                    sh '''
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" -e "SELECT VERSION() AS mariadb_version;"
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" -e "DROP DATABASE IF EXISTS ${DB_NAME}; CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;"
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" < dump-dbgestor-202406261453.sql
                        echo "Dump importado exitosamente en ${DB_HOST}/${DB_NAME}."
                    '''
                }
            }
        }

        stage('Validar Estructura (Tablas, PKs y FKs)') {
            steps {
                withCredentials([string(credentialsId: 'mariadb-ci-password', variable: 'DB_PASS')]) {
                    sh '''
                        echo "=== 1. TABLAS EN DBGESTOR ===" > reporte_estructura_bd.txt
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" -t -e "SHOW TABLES;" >> reporte_estructura_bd.txt

                        for tbl in asignaciones comentarios hibernate_sequence proyectos tareas usuario; do
                            cnt=$(mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" -N -B "${DB_NAME}" -e "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='${DB_NAME}' AND TABLE_NAME='${tbl}';")
                            if [ "$cnt" -ne "1" ]; then
                                echo "ERROR: Falta la tabla requerida: ${tbl}"
                                exit 1
                            fi
                            echo "Tabla verificada: ${tbl} (OK)" >> reporte_estructura_bd.txt
                        done

                        echo "\n=== 2. APLICACIÓN Y VALIDACIÓN DE LLAVES FORÁNEAS E ÍNDICES ===" >> reporte_estructura_bd.txt
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" -e "
                            ALTER TABLE tareas ADD CONSTRAINT fk_tareas_proyecto FOREIGN KEY (id_proyecto) REFERENCES proyectos(id_proyecto) ON DELETE CASCADE;
                            ALTER TABLE comentarios ADD CONSTRAINT fk_comentarios_tarea FOREIGN KEY (id_tarea) REFERENCES tareas(id_tarea) ON DELETE CASCADE;
                            ALTER TABLE asignaciones ADD CONSTRAINT fk_asignaciones_tarea FOREIGN KEY (id_tarea) REFERENCES tareas(id_tarea) ON DELETE CASCADE;
                            ALTER TABLE asignaciones ADD CONSTRAINT fk_asignaciones_usuario FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario) ON DELETE CASCADE;
                        "

                        echo "\n=== 3. LLAVES PRIMARIAS Y FORÁNEAS REGISTRADAS (INFORMATION_SCHEMA) ===" >> reporte_estructura_bd.txt
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" -t -e "
                            SELECT TABLE_NAME, CONSTRAINT_NAME, CONSTRAINT_TYPE
                            FROM information_schema.TABLE_CONSTRAINTS
                            WHERE TABLE_SCHEMA = '${DB_NAME}'
                            ORDER BY TABLE_NAME, CONSTRAINT_TYPE;
                        " >> reporte_estructura_bd.txt

                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" -t -e "
                            SELECT TABLE_NAME, COLUMN_NAME, CONSTRAINT_NAME, REFERENCED_TABLE_NAME, REFERENCED_COLUMN_NAME
                            FROM information_schema.KEY_COLUMN_USAGE
                            WHERE TABLE_SCHEMA = '${DB_NAME}'
                            ORDER BY TABLE_NAME, COLUMN_NAME;
                        " >> reporte_estructura_bd.txt

                        cat reporte_estructura_bd.txt
                    '''
                }
            }
        }

        stage('Pruebas CRUD de Base de Datos') {
            steps {
                withCredentials([string(credentialsId: 'mariadb-ci-password', variable: 'DB_PASS')]) {
                    sh '''
                        echo "=== PRUEBAS CRUD SOBRE DBGESTOR ===" > reporte_crud_bd.txt
                        mariadb --skip-ssl -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" -t -e "
                            -- CREATE (INSERT)
                            INSERT INTO usuario (id_usuario, nombre, correo_electronico, contrasena, rol, imagen_usuario)
                            VALUES (9901, 'Juana Jaqueline Camarillo', 'jaqueline@utng.edu.mx', 'Secret123!', 'Administrador', '#2563EB');

                            INSERT INTO proyectos (id_proyecto, nombre, descripcion, fecha_inicio, fecha_finalizacion, estado_proyecto, fondo)
                            VALUES (9902, 'Proyecto CI Automatizado', 'Validacion CRUD en pipeline', '2026-03-01', '2026-03-31', 'En proceso', '/Images/animacion1.gif');

                            INSERT INTO tareas (id_tarea, nombre, descripcion, fecha_vencimiento, estado, lista, id_proyecto)
                            VALUES (9903, 'Tarea CI', 'Verificar integridad referencial', '2026-03-10', 'warning', 'en_proceso', 9902);

                            INSERT INTO asignaciones (id_asignacion, id_usuario, id_tarea, fecha_asignacion)
                            VALUES (9904, 9901, 9903, '2026-03-02');

                            INSERT INTO comentarios (id_comentario, texto_comentario, fecha_hora, id_usuario, id_tarea)
                            VALUES (9905, 'Comentario de prueba CRUD en pipeline', '2026-03-03 10:00:00', 'Juana Jaqueline Camarillo', 9903);

                            -- READ (SELECT JOIN)
                            SELECT p.id_proyecto, p.nombre AS proyecto, t.nombre AS tarea, t.estado, u.nombre AS responsable, c.texto_comentario
                            FROM proyectos p
                            INNER JOIN tareas t ON t.id_proyecto = p.id_proyecto
                            INNER JOIN asignaciones a ON a.id_tarea = t.id_tarea
                            INNER JOIN usuario u ON u.id_usuario = a.id_usuario
                            INNER JOIN comentarios c ON c.id_tarea = t.id_tarea
                            WHERE p.id_proyecto = 9902;

                            -- UPDATE
                            UPDATE tareas SET estado = 'success', lista = 'terminado' WHERE id_tarea = 9903;
                            SELECT id_tarea, nombre, estado, lista FROM tareas WHERE id_tarea = 9903;

                            -- DELETE
                            DELETE FROM comentarios WHERE id_comentario = 9905;
                            DELETE FROM asignaciones WHERE id_asignacion = 9904;
                            DELETE FROM tareas WHERE id_tarea = 9903;
                            DELETE FROM proyectos WHERE id_proyecto = 9902;
                            DELETE FROM usuario WHERE id_usuario = 9901;

                            SELECT COUNT(*) AS registros_temporales_restantes FROM proyectos WHERE id_proyecto = 9902;
                        " >> reporte_crud_bd.txt

                        cat reporte_crud_bd.txt
                    '''
                }
            }
        }

        stage('Análisis de Calidad SQL (SQLFluff Lint)') {
            steps {
                sh '''
                    cat << 'EOF' > validacion_calidad_dbgestor.sql
SELECT
    p.id_proyecto,
    p.nombre AS proyecto_nombre,
    t.id_tarea,
    t.nombre AS tarea_nombre,
    t.estado AS tarea_estado,
    u.correo_electronico AS usuario_correo
FROM proyectos AS p
INNER JOIN tareas AS t
    ON p.id_proyecto = t.id_proyecto
INNER JOIN asignaciones AS a
    ON t.id_tarea = a.id_tarea
INNER JOIN usuario AS u
    ON a.id_usuario = u.id_usuario
WHERE t.estado IS NOT NULL
ORDER BY p.id_proyecto ASC, t.id_tarea ASC;
EOF
                    sqlfluff lint --dialect mariadb validacion_calidad_dbgestor.sql | tee reporte_sqlfluff.txt
                    sqlfluff lint --dialect mariadb --format json dump-dbgestor-202406261453.sql > reporte_sqlfluff_dump.json || true
                    echo "Análisis de calidad SQL con SQLFluff completado." >> reporte_sqlfluff.txt
                '''
            }
        }

        stage('Archivar Resultados') {
            steps {
                archiveArtifacts artifacts: 'reporte_estructura_bd.txt,reporte_crud_bd.txt,reporte_sqlfluff.txt,reporte_sqlfluff_dump.json,validacion_calidad_dbgestor.sql', fingerprint: true
            }
        }
    }
}
